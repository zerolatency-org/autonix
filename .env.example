# Copy this file to .env and fill it in.  cp .env.example .env
# NEVER commit .env. Only use TESTNET wallets here.

# --- 0G Galileo testnet ---
ZG_CHAIN_ID=16602
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_EXPLORER_URL=https://chainscan-galileo.0g.ai

# --- Testnet-only private keys (0x...). Leave empty until Phase 1. ---
DEPLOYER_PRIVATE_KEY=
EVALUATOR_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
RUNTIME_PRIVATE_KEY=

# --- Local model for development (Phase 2) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b