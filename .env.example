# Copy this file to .env and fill it in.
# NEVER commit .env. Only use TESTNET wallets here.

# --- 0G Galileo testnet ---
ZG_CHAIN_ID=16602
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_EXPLORER_URL=https://chainscan-galileo.0g.ai

# --- Testnet-only private keys (0x...) ---
# Generate two fresh wallets with: cast wallet new
DEPLOYER_PRIVATE_KEY=0x...
EVALUATOR_PRIVATE_KEY=0x...

# EVALUATOR_ADDRESS is the PUBLIC address of the evaluator wallet.
# Derive it from the private key above with:
#   cast wallet address --private-key $EVALUATOR_PRIVATE_KEY
EVALUATOR_ADDRESS=0x...

ORACLE_PRIVATE_KEY=
RUNTIME_PRIVATE_KEY=

# --- Local model for development ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b